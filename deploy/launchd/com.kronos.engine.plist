<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.kronos.engine</string>
    <key>ProgramArguments</key>
    <array>
      <string>/usr/local/bin/kronos-engine</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
      <key>KRONOS_BIND_HOST</key>
      <string>127.0.0.1</string>
    </dict>
  </dict>
</plist>
