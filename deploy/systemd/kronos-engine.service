[Unit]
Description=Kronos local control-plane engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/kronos-engine
Restart=on-failure
RestartSec=3
Environment=KRONOS_BIND_HOST=127.0.0.1
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=kronos
ReadWritePaths=%h/.local/share/kronos %h/.config/kronos %h/.cache/kronos
PrivateTmp=true

[Install]
WantedBy=default.target
